---
interface Props {
  title: string;
  subtitle?: string;
}
const { title, subtitle } = Astro.props;
---

<section
  class="relative pt-52 pb-20 text-center overflow-hidden"
  style="background: linear-gradient(135deg, var(--blush-light) 0%, var(--off-white) 60%, white 100%);"
>
  <!-- Decorative botanical shapes -->
  <div
    class="absolute inset-0 pointer-events-none"
    aria-hidden="true"
  >
    <div
      class="absolute top-10 left-10 w-32 h-32 rounded-full opacity-20"
      style="background: radial-gradient(circle, var(--blush) 0%, transparent 70%);"
    ></div>
    <div
      class="absolute bottom-5 right-16 w-48 h-48 rounded-full opacity-15"
      style="background: radial-gradient(circle, var(--coral) 0%, transparent 70%);"
    ></div>
  </div>

  <div class="relative max-w-3xl mx-auto px-6">
    <div class="section-divider"></div>
    <h1
      class="text-5xl lg:text-6xl font-light leading-tight mb-4"
      style="font-family: var(--font-heading); color: var(--charcoal);"
    >
      {title}
    </h1>
    {subtitle && (
      <p class="text-lg" style="color: var(--warm-grey); font-family: var(--font-body);">
        {subtitle}
      </p>
    )}
  </div>
</section>
