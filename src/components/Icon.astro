---
interface Props {
  name: string;
  class?: string;
}
const { name, class: className = 'w-6 h-6' } = Astro.props;
---

{name === 'sparkle' && (
  <svg class={className} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
    <path d="M12 2 L13.5 9 L20.5 10.5 L13.5 12 L12 19 L10.5 12 L3.5 10.5 L10.5 9 Z" />
    <path d="M19 4 L19.5 6 L21.5 6.5 L19.5 7 L19 9 L18.5 7 L16.5 6.5 L18.5 6 Z" fill="currentColor" />
  </svg>
)}

{name === 'diamond' && (
  <svg class={className} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
    <path d="M12 3 L21 12 L12 21 L3 12 Z" />
    <path d="M12 7 L17 12 L12 17 L7 12 Z" />
  </svg>
)}

{name === 'rhombus' && (
  <svg class={className} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
    <path d="M12 3 L21 12 L12 21 L3 12 Z" />
  </svg>
)}

{name === 'circle-dot' && (
  <svg class={className} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
    <circle cx="12" cy="12" r="9" />
    <circle cx="12" cy="12" r="3" fill="currentColor" />
  </svg>
)}

{name === 'circle-rings' && (
  <svg class={className} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
    <circle cx="12" cy="12" r="9" />
    <circle cx="12" cy="12" r="5" />
    <circle cx="12" cy="12" r="1.5" fill="currentColor" />
  </svg>
)}

{name === 'flower' && (
  <svg class={className} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
    <circle cx="12" cy="6" r="3" />
    <circle cx="6" cy="12" r="3" />
    <circle cx="18" cy="12" r="3" />
    <circle cx="12" cy="18" r="3" />
    <circle cx="12" cy="12" r="1.5" fill="currentColor" />
  </svg>
)}

{name === 'leaf' && (
  <svg class={className} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
    <path d="M5 19c0-8 6-14 14-14 0 8-6 14-14 14z" />
    <path d="M5 19 L13 11" />
  </svg>
)}

{name === 'sun-burst' && (
  <svg class={className} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
    <circle cx="12" cy="12" r="4" />
    <path d="M12 2 v3 M12 19 v3 M2 12 h3 M19 12 h3 M5 5 l2 2 M17 17 l2 2 M5 19 l2-2 M17 7 l2-2" />
  </svg>
)}

{name === 'graduate' && (
  <svg class={className} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
    <path d="M2 9 L12 4 L22 9 L12 14 Z" />
    <path d="M6 11 v5 c0 2 3 3 6 3 s6-1 6-3 v-5" />
    <path d="M22 9 v6" />
  </svg>
)}

{name === 'shield' && (
  <svg class={className} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
    <path d="M12 2 L20 5 v7 c0 5-4 8-8 10 -4-2-8-5-8-10 V5 Z" />
    <path d="M9 12 L11 14 L15 10" />
  </svg>
)}

{name === 'medical' && (
  <svg class={className} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
    <circle cx="12" cy="12" r="9" />
    <path d="M12 7 v10 M7 12 h10" />
  </svg>
)}

{name === 'book' && (
  <svg class={className} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
    <path d="M4 5 c0-1 1-2 2-2 h5 v17 H6 c-1 0-2-1-2-2 Z" />
    <path d="M20 5 c0-1-1-2-2-2 h-5 v17 h5 c1 0 2-1 2-2 Z" />
    <path d="M12 3 v17" />
  </svg>
)}

{name === 'calendar' && (
  <svg class={className} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
    <rect x="3" y="5" width="18" height="16" rx="2" />
    <path d="M3 10 h18 M8 3 v4 M16 3 v4" />
    <circle cx="8" cy="14" r="1" fill="currentColor" />
    <circle cx="12" cy="14" r="1" fill="currentColor" />
    <circle cx="16" cy="14" r="1" fill="currentColor" />
  </svg>
)}
