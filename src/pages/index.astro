---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';

import { featuredCategories } from '../data/treatments';
---

<Layout
  title="Skin Aesthetics Northampton — Premium Aesthetic Treatments"
  description="Premium aesthetic treatments in Northampton. PRP, microneedling, skin boosters, facials and more. Book your free consultation today."
>
  <Nav />

  <!-- ===================== HERO ===================== -->
  <section
    class="relative min-h-screen flex items-center justify-center overflow-hidden"
    aria-label="Hero"
  >
    <!-- Background image with Ken Burns -->
    <div class="absolute inset-0 overflow-hidden">
      <img
        src="https://images.unsplash.com/photo-1616394584738-fc6e612e71b9?w=1920&q=80&auto=format&fit=crop"
        alt="Skin treatment in a warm, intimate clinic setting"
        class="w-full h-full object-cover"
        width="1920"
        height="1080"
        loading="eager"
      />
      <!-- Warm gradient overlay -->
      <div
        class="absolute inset-0"
        style="background: linear-gradient(135deg, rgba(63,38,17,0.65) 0%, rgba(17,17,17,0.7) 100%);"
      ></div>
    </div>

    <!-- Hero content -->
    <div class="relative z-10 max-w-3xl mx-auto px-6 text-center text-white" style="text-shadow: 0 2px 24px rgba(0,0,0,0.3);">
      <p
        class="text-xs font-medium tracking-[0.3em] uppercase mb-8 opacity-80"
        style="font-family: var(--font-body);"
      >
        Skin Aesthetics &middot; Northampton
      </p>
      <h1
        class="text-5xl sm:text-6xl lg:text-7xl xl:text-8xl font-normal text-balance leading-[1] mb-8"
        style="font-family: var(--font-heading);"
      >
        Skin, refined.
      </h1>
      <p
        class="text-lg sm:text-xl leading-relaxed mb-12 opacity-90 max-w-md mx-auto font-light"
        style="font-style: italic;"
      >
        Considered treatments, delivered by hand.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href="/book"
          class="inline-flex items-center justify-center px-8 py-4 rounded-sm text-sm font-medium tracking-wide text-white transition-all duration-200"
          style="background-color: var(--brown-primary);"
          onmouseover="this.style.backgroundColor='var(--brown-deep)'"
          onmouseout="this.style.backgroundColor='var(--brown-primary)'"
        >
          Book a Consultation
        </a>
        <a
          href="/services"
          class="inline-flex items-center justify-center px-8 py-4 rounded-sm text-sm font-medium tracking-wide transition-all duration-200"
          style="border: 1.5px solid rgba(255,255,255,0.7); color: white;"
          onmouseover="this.style.background='rgba(255,255,255,0.15)'"
          onmouseout="this.style.background='transparent'"
        >
          See Treatments
        </a>
      </div>
    </div>

  </section>

  <!-- ===================== PROMO BANNER ===================== -->


  <!-- ===================== TRUST BAR ===================== -->
  <section style="background-color: var(--off-white); border-bottom: 1px solid var(--light-grey);">
    <div class="max-w-7xl mx-auto px-6 lg:px-8 py-12">
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-8">
        {[
          {
            icon: `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" /></svg>`,
            label: 'Fully Qualified & Insured',
          },
          {
            icon: `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>`,
            label: 'Free Initial Consultation',
          },
          {
            icon: `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg>`,
            label: "Northampton's Premier Clinic",
          },
          {
            icon: `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" /></svg>`,
            label: 'Medical-Grade Treatments',
          },
        ].map((item, i) => (
          <div class={`flex flex-col items-center text-center gap-3 reveal reveal-delay-${i + 1}`}>
            <div style="color: var(--rose-primary);" set:html={item.icon} />
            <p class="text-sm font-medium" style="color: var(--charcoal); font-family: var(--font-body);">
              {item.label}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ===================== SERVICES PREVIEW ===================== -->
  <section class="py-40 px-6 lg:px-8" style="background: white;">
    <div class="max-w-6xl mx-auto">
      <div class="mb-20 reveal">
        <p
          class="text-xs font-medium tracking-[0.2em] uppercase mb-4"
          style="color: var(--caramel);"
        >
          What we do
        </p>
        <h2
          class="text-5xl lg:text-6xl font-normal text-balance leading-[1.05]"
          style="font-family: var(--font-heading); color: var(--charcoal);"
        >
          Considered treatments,<br/><em style="font-style: italic;">tailored to you.</em>
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-0">
        {
          featuredCategories.map((cat, i) => (
            <a
              href={`/services/${cat.slug}`}
              class={`group block reveal reveal-delay-${(i % 3) + 1} pt-8 pb-8 ${i === 0 ? '' : 'border-t'}`}
              style={i === 0 ? '' : 'border-color: rgba(42,32,24,0.10);'}
            >
              <div class="flex items-baseline gap-6 mb-3">
                <span
                  class="text-xs font-medium tracking-[0.2em]"
                  style="color: var(--caramel);"
                >
                  {String(i + 1).padStart(2, '0')}
                </span>
                <div class="flex-1"></div>
                <span
                  class="text-xs font-medium tracking-wide"
                  style="color: var(--brown-primary);"
                >
                  From {cat.startingFrom}
                </span>
              </div>
              <h3
                class="text-2xl font-medium mb-2 transition-opacity duration-200 group-hover:opacity-70"
                style="color: var(--charcoal);"
              >
                {cat.name}
              </h3>
              <p class="text-base leading-relaxed" style="color: var(--warm-grey);">
                {cat.description}
              </p>
            </a>
          ))
        }
      </div>

      <div class="mt-20 reveal">
        <a
          href="/services"
          class="inline-flex items-center gap-3 text-sm font-medium tracking-wide transition-all duration-200 group"
          style="color: var(--brown-primary);"
        >
          See all treatments
          <svg class="w-4 h-4 transition-transform duration-200 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- ===================== ABOUT INTRO ===================== -->
  <section class="py-40 px-6 lg:px-8" style="background-color: var(--ivory);">
    <div class="max-w-6xl mx-auto">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-20 items-center">
        <!-- Image: 5/12 -->
        <div class="lg:col-span-5 reveal">
          <div class="aspect-[4/5] overflow-hidden">
            <img
              src="/images/1.jpg"
              alt="Kate, Skin Aesthetics Northampton practitioner"
              class="w-full h-full object-cover"
              width="800"
              height="1000"
              loading="lazy"
            />
          </div>
        </div>
        <!-- Text: 6/12, offset by 1 col from image -->
        <div class="lg:col-span-6 lg:col-start-7 reveal reveal-delay-2">
          <p
            class="text-xs font-medium tracking-[0.2em] uppercase mb-6"
            style="color: var(--caramel); font-family: var(--font-body);"
          >
            Meet Kate
          </p>
          <h2
            class="text-4xl lg:text-6xl font-normal text-balance mb-8 leading-[1.05]"
            style="font-family: var(--font-heading); color: var(--charcoal);"
          >
            Sixteen years in the field.<br/><em style="font-style: italic;">A lifetime of care.</em>
          </h2>
          <p class="text-lg leading-relaxed mb-8 font-light text-justify hyphens-auto" style="color: var(--warm-grey);">
            With over 16 years of medical experience, I combine advanced clinical knowledge with a genuine passion for aesthetic medicine. My approach is centred around enhancing your natural beauty, never changing it.
          </p>
          <a
            href="/about"
            class="inline-flex items-center gap-3 text-sm font-medium tracking-wide transition-all duration-200 group"
            style="color: var(--brown-primary);"
          >
            More about Kate
            <svg class="w-4 h-4 transition-transform duration-200 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  {/* Before & After teaser hidden until real client photos are available (Phase 2) */}

  <!-- ===================== BOOKING CTA BANNER ===================== -->
  <section
    class="py-40 px-6 lg:px-8 text-center"
    style="background: var(--off-white);"
  >
    <div class="max-w-2xl mx-auto reveal">
      <h2
        class="text-4xl lg:text-6xl font-normal text-balance mb-6 leading-[1.05]"
        style="font-family: var(--font-heading); color: var(--charcoal);"
      >
        Begin with a <em style="font-style: italic;">conversation</em>.
      </h2>
      <p class="text-lg mb-12" style="font-style: italic; color: var(--warm-grey);">
        A free consultation. No pressure, no obligation.
      </p>
      <a
        href="/book"
        class="inline-flex items-center justify-center px-10 py-4 rounded-sm text-sm font-medium tracking-wide transition-all duration-200 text-white"
        style="background-color: var(--brown-primary);"
        onmouseover="this.style.backgroundColor='var(--brown-deep)'"
        onmouseout="this.style.backgroundColor='var(--brown-primary)'"
      >
        Book Now
      </a>
    </div>
  </section>

  <!-- ===================== TESTIMONIALS ===================== -->
  <section class="py-40 px-6 lg:px-8" style="background: white;">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-20 reveal">
        <p
          class="text-xs font-medium tracking-[0.2em] uppercase mb-4"
          style="color: var(--caramel);"
        >
          In their words
        </p>
        <h2
          class="text-4xl lg:text-6xl font-normal text-balance leading-[1.05]"
          style="font-family: var(--font-heading); color: var(--charcoal);"
        >
          Trusted by our clients.
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {[
          {
            quote: "Absolutely life-changing! My skin has never looked better. The practitioner made me feel so comfortable and the results exceeded my expectations.",
            name: "Sarah M.",
            treatment: "PRP Facial Rejuvenation",
          },
          {
            quote: "I was nervous about trying aesthetic treatments but the consultation was so reassuring. The microneedling results are incredible — my pores are visibly smaller.",
            name: "Emma L.",
            treatment: "Microneedling",
          },
          {
            quote: "Professional, warm, and genuinely passionate about skincare. The Glass Skin Facial left me glowing for weeks. I won't go anywhere else!",
            name: "Olivia K.",
            treatment: "Glass Skin Facial",
          },
        ].map((t, i) => (
          <article
            class={`rounded-2xl p-8 reveal reveal-delay-${i + 1}`}
            style="background-color: var(--off-white); border: 1px solid var(--light-grey);"
          >
            <div class="flex gap-1 mb-5" aria-label="5 stars">
              {[1,2,3,4,5].map(() => (
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20" style="color: var(--rose-primary);">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                </svg>
              ))}
            </div>
            <blockquote
              class="text-sm leading-relaxed mb-6 italic"
              style="color: var(--charcoal); font-family: var(--font-heading); font-size: 1.05rem;"
            >
              "{t.quote}"
            </blockquote>
            <div>
              <p class="text-sm font-medium" style="color: var(--charcoal);">{t.name}</p>
              <p class="text-xs" style="color: var(--rose-primary);">{t.treatment}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <Footer />
</Layout>
