---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';

import { featuredCategories } from '../data/treatments';
---

<Layout
  title="Skin Aesthetics Northampton — Premium Aesthetic Treatments"
  description="Premium aesthetic treatments in Northampton. PRP, microneedling, skin boosters, facials and more. Book your free consultation today."
>
  <Nav />

  <!-- ===================== HERO ===================== -->
  <section
    class="relative min-h-screen flex items-center justify-center overflow-hidden"
    aria-label="Hero"
  >
    <!-- Background image with Ken Burns -->
    <div class="absolute inset-0 overflow-hidden">
      <img
        src="https://images.unsplash.com/photo-1616394584738-fc6e612e71b9?w=1920&q=80&auto=format&fit=crop"
        alt="Skin treatment in a warm, intimate clinic setting"
        class="w-full h-full object-cover"
        width="1920"
        height="1080"
        loading="eager"
      />
      <!-- Warm gradient overlay -->
      <div
        class="absolute inset-0"
        style="background: linear-gradient(135deg, rgba(92,58,30,0.55) 0%, rgba(17,17,17,0.55) 100%);"
      ></div>
    </div>

    <!-- Hero content -->
    <div class="relative z-10 max-w-3xl mx-auto px-6 text-center text-white">
      <p
        class="text-sm font-medium tracking-widest uppercase mb-6 opacity-90"
        style="font-family: var(--font-body);"
      >
        Northampton's Premier Aesthetics Clinic
      </p>
      <h1
        class="text-5xl sm:text-6xl lg:text-7xl font-light leading-tight mb-6"
        style="font-family: var(--font-heading);"
      >
        Your skin.<br />Your confidence.<br />Your glow.
      </h1>
      <p
        class="text-lg sm:text-xl leading-relaxed mb-10 opacity-90 max-w-xl mx-auto"
        style="font-family: var(--font-body);"
      >
        Premium aesthetic treatments in Northampton, delivered with care, precision, and expertise.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href="/book"
          class="inline-flex items-center justify-center px-8 py-4 rounded-lg text-sm font-medium tracking-wide text-white transition-all duration-200"
          style="background-color: var(--rose-primary);"
          onmouseover="this.style.backgroundColor='var(--rose-deep)'"
          onmouseout="this.style.backgroundColor='var(--rose-primary)'"
        >
          Book a Consultation
        </a>
        <a
          href="/services"
          class="inline-flex items-center justify-center px-8 py-4 rounded-lg text-sm font-medium tracking-wide transition-all duration-200"
          style="border: 1.5px solid rgba(255,255,255,0.7); color: white;"
          onmouseover="this.style.background='rgba(255,255,255,0.15)'"
          onmouseout="this.style.background='transparent'"
        >
          Explore Treatments
        </a>
      </div>
    </div>

  </section>

  <!-- ===================== PROMO BANNER ===================== -->


  <!-- ===================== TRUST BAR ===================== -->
  <section style="background-color: var(--off-white); border-bottom: 1px solid var(--light-grey);">
    <div class="max-w-7xl mx-auto px-6 lg:px-8 py-12">
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-8">
        {[
          {
            icon: `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" /></svg>`,
            label: 'Fully Qualified & Insured',
          },
          {
            icon: `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>`,
            label: 'Free Initial Consultation',
          },
          {
            icon: `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg>`,
            label: "Northampton's Premier Clinic",
          },
          {
            icon: `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" /></svg>`,
            label: 'Medical-Grade Treatments',
          },
        ].map((item, i) => (
          <div class={`flex flex-col items-center text-center gap-3 reveal reveal-delay-${i + 1}`}>
            <div style="color: var(--rose-primary);" set:html={item.icon} />
            <p class="text-sm font-medium" style="color: var(--charcoal); font-family: var(--font-body);">
              {item.label}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ===================== SERVICES PREVIEW ===================== -->
  <section class="py-24 px-6 lg:px-8" style="background: white;">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-16 reveal">
        <div class="section-divider"></div>
        <h2
          class="text-4xl lg:text-5xl font-light mb-4"
          style="font-family: var(--font-heading); color: var(--charcoal);"
        >
          Our Treatments
        </h2>
        <p class="text-base max-w-xl mx-auto" style="color: var(--warm-grey);">
          Expertly performed aesthetic treatments tailored to you.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {
          featuredCategories.map((cat, i) => (
            <article
              class={`group relative bg-white rounded-2xl p-7 transition-all duration-300 reveal reveal-delay-${(i % 3) + 1}`}
              style="box-shadow: 0 2px 16px rgba(92,58,30,0.08); border: 1px solid var(--light-grey);"
            >
              <div
                class="w-12 h-12 rounded-full flex items-center justify-center mb-5"
                style="background-color: var(--blush-light); color: var(--rose-primary);"
              >
                <Icon name={cat.icon} class="w-6 h-6" />
              </div>
              <h3
                class="text-xl font-medium mb-2"
                style="font-family: var(--font-heading); color: var(--charcoal);"
              >
                {cat.name}
              </h3>
              <p class="text-sm leading-relaxed mb-4" style="color: var(--warm-grey);">
                {cat.description}
              </p>
              <div class="flex items-center justify-between mt-auto">
                <span class="text-sm font-medium" style="color: var(--rose-primary);">
                  From {cat.startingFrom}
                </span>
                <a
                  href={`/services/${cat.slug}`}
                  class="text-sm font-medium tracking-wide transition-colors duration-200"
                  style="color: var(--charcoal);"
                  onmouseover="this.style.color='var(--rose-primary)'"
                  onmouseout="this.style.color='var(--charcoal)'"
                >
                  Learn More →
                </a>
              </div>
              <div
                class="absolute top-0 left-0 right-0 h-0.5 rounded-t-2xl opacity-0 group-hover:opacity-100 transition-opacity duration-300"
                style="background: linear-gradient(90deg, var(--rose-primary), var(--coral));"
              ></div>
            </article>
          ))
        }
      </div>

      <div class="text-center mt-12 reveal">
        <a
          href="/services"
          class="inline-flex items-center justify-center px-8 py-3.5 rounded-lg text-sm font-medium tracking-wide transition-all duration-200"
          style="border: 1.5px solid var(--rose-primary); color: var(--rose-primary);"
          onmouseover="this.style.background='var(--rose-primary)'; this.style.color='white';"
          onmouseout="this.style.background='transparent'; this.style.color='var(--rose-primary)';"
        >
          View All Treatments
        </a>
      </div>
    </div>
  </section>

  <!-- ===================== ABOUT INTRO ===================== -->
  <section class="py-24 px-6 lg:px-8" style="background-color: var(--off-white);">
    <div class="max-w-7xl mx-auto">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
        <div class="reveal">
          <div
            class="aspect-[4/5] rounded-3xl overflow-hidden"
            style="background-color: var(--blush-light);"
          >
            <img
              src="/images/1.jpg"
              alt="Skin Aesthetics Northampton practitioner"
              class="w-full h-full object-cover"
              width="800"
              height="1000"
              loading="lazy"
            />
          </div>
        </div>
        <div class="reveal reveal-delay-2">
          <div class="section-divider" style="margin-left: 0;"></div>
          <p
            class="text-sm font-medium tracking-widest uppercase mb-3"
            style="color: var(--rose-primary); font-family: var(--font-body);"
          >
            Meet Kate
          </p>
          <h2
            class="text-4xl lg:text-5xl font-light mb-6"
            style="font-family: var(--font-heading); color: var(--charcoal);"
          >
            Your Practitioner
          </h2>
          <p class="text-base leading-relaxed mb-4" style="color: var(--warm-grey);">
            With over 16 years of medical experience, I combine advanced clinical knowledge with a genuine passion for aesthetic medicine to help clients look and feel their absolute best.
          </p>
          <p class="text-base leading-relaxed mb-8" style="color: var(--warm-grey);">
            My approach is centred around enhancing your natural beauty, delivering refined, confidence-boosting results that never look overdone. Every treatment is performed with the highest standards of safety, care, and professionalism.
          </p>
          <a
            href="/about"
            class="inline-flex items-center gap-2 text-sm font-medium tracking-wide transition-colors duration-200"
            style="color: var(--rose-primary);"
          >
            Learn More About Us
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== BEFORE & AFTER TEASER ===================== -->
  <section class="py-24 px-6 lg:px-8" style="background-color: white;">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-16 reveal">
        <div class="section-divider"></div>
        <h2
          class="text-4xl lg:text-5xl font-light mb-4"
          style="font-family: var(--font-heading); color: var(--charcoal);"
        >
          Real Results
        </h2>
        <p class="text-base" style="color: var(--warm-grey);">
          Transformations achieved with care and expertise.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
        {[1, 2, 3].map((_, i) => (
          <div class={`reveal reveal-delay-${i + 1}`}>
            <div
              class="rounded-2xl overflow-hidden aspect-[3/4] flex items-center justify-center"
              style="background: linear-gradient(135deg, var(--blush) 0%, var(--blush-light) 100%);"
            >
              <div class="text-center px-6">
                <svg class="w-10 h-10 mx-auto mb-3" viewBox="0 0 24 24" fill="currentColor" style="color: var(--rose-primary);" aria-hidden="true">
                  <path d="M12 2 L13.5 9 L20.5 10.5 L13.5 12 L12 19 L10.5 12 L3.5 10.5 L10.5 9 Z" />
                </svg>
                <p class="text-sm font-medium" style="color: var(--warm-grey); font-family: var(--font-body);">
                  Before &amp; After
                </p>
                <p class="text-xs mt-1" style="color: var(--warm-grey);">Real client result</p>
                <p class="text-xs mt-2 italic" style="color: var(--warm-grey);">(Photo coming in Phase 2)</p>
              </div>
            </div>
          </div>
        ))}
      </div>

      <div class="text-center mt-12 reveal">
        <a
          href="/gallery"
          class="inline-flex items-center justify-center px-8 py-3.5 rounded-lg text-sm font-medium tracking-wide transition-all duration-200"
          style="border: 1.5px solid var(--rose-primary); color: var(--rose-primary);"
          onmouseover="this.style.background='var(--rose-primary)'; this.style.color='white';"
          onmouseout="this.style.background='transparent'; this.style.color='var(--rose-primary)';"
        >
          View Full Gallery
        </a>
      </div>
    </div>
  </section>

  <!-- ===================== BOOKING CTA BANNER ===================== -->
  <section
    class="py-24 px-6 lg:px-8 text-center"
    style="background: var(--off-white);"
  >
    <div class="max-w-2xl mx-auto reveal">
      <div class="section-divider"></div>
      <h2
        class="text-4xl lg:text-5xl font-light mb-4"
        style="font-family: var(--font-heading); color: var(--charcoal);"
      >
        Ready to start your skin journey?
      </h2>
      <p class="text-lg mb-10" style="font-family: var(--font-body); color: var(--body-text);">
        Book your consultation online in minutes.
      </p>
      <a
        href="/book"
        class="inline-flex items-center justify-center px-10 py-4 rounded-lg text-sm font-medium tracking-wide transition-all duration-200 text-white"
        style="background-color: var(--rose-primary);"
        onmouseover="this.style.backgroundColor='var(--rose-deep)'"
        onmouseout="this.style.backgroundColor='var(--rose-primary)'"
      >
        Book Now
      </a>
    </div>
  </section>

  <!-- ===================== TESTIMONIALS ===================== -->
  <section class="py-24 px-6 lg:px-8" style="background: white;">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-16 reveal">
        <div class="section-divider"></div>
        <h2
          class="text-4xl lg:text-5xl font-light mb-4"
          style="font-family: var(--font-heading); color: var(--charcoal);"
        >
          What Our Clients Say
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {[
          {
            quote: "Absolutely life-changing! My skin has never looked better. The practitioner made me feel so comfortable and the results exceeded my expectations.",
            name: "Sarah M.",
            treatment: "PRP Facial Rejuvenation",
          },
          {
            quote: "I was nervous about trying aesthetic treatments but the consultation was so reassuring. The microneedling results are incredible — my pores are visibly smaller.",
            name: "Emma L.",
            treatment: "Microneedling",
          },
          {
            quote: "Professional, warm, and genuinely passionate about skincare. The Glass Skin Facial left me glowing for weeks. I won't go anywhere else!",
            name: "Olivia K.",
            treatment: "Glass Skin Facial",
          },
        ].map((t, i) => (
          <article
            class={`rounded-2xl p-8 reveal reveal-delay-${i + 1}`}
            style="background-color: var(--off-white); border: 1px solid var(--light-grey);"
          >
            <div class="flex gap-1 mb-5" aria-label="5 stars">
              {[1,2,3,4,5].map(() => (
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20" style="color: var(--rose-primary);">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                </svg>
              ))}
            </div>
            <blockquote
              class="text-sm leading-relaxed mb-6 italic"
              style="color: var(--charcoal); font-family: var(--font-heading); font-size: 1.05rem;"
            >
              "{t.quote}"
            </blockquote>
            <div>
              <p class="text-sm font-medium" style="color: var(--charcoal);">{t.name}</p>
              <p class="text-xs" style="color: var(--rose-primary);">{t.treatment}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <Footer />
</Layout>
