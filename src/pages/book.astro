---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import PageHero from '../components/PageHero.astro';
---

<Layout
  title="Book an Appointment — Skin Aesthetics Northampton"
  description="Book your aesthetic treatment or free consultation at Skin Aesthetics Northampton. Online booking available 24/7."
>
  <Nav />

  <PageHero
    title="Book Your Appointment"
    subtitle="Online booking, available anytime."
  />

  <section class="py-16 px-6 lg:px-8" style="background: white;">
    <div class="max-w-4xl mx-auto">
      <!-- Intro -->
      <div class="text-center mb-12 reveal">
        <p class="text-base leading-relaxed max-w-2xl mx-auto" style="color: var(--warm-grey);">
          Use the booking calendar below to choose your preferred time. Not sure which treatment to book? Select a <strong>Free Skin Consultation</strong> and our practitioner will guide you to the perfect plan.
        </p>
      </div>

      <!-- Calendly inline embed -->
      <div
        class="rounded-2xl overflow-hidden reveal"
        style="border: 1px solid var(--light-grey); box-shadow: 0 4px 32px rgba(92,58,30,0.08);"
      >
        <div
          class="calendly-inline-widget"
          data-url="https://calendly.com/skinaesthetics19/30min?hide_gdpr_banner=1&primary_color=c4717a"
          style="min-width:320px;height:700px;"
        ></div>
        <script type="text/javascript" src="https://assets.calendly.com/assets/external/widget.js" async></script>
      </div>

      <!-- Contact form -->
      <div class="mt-16 reveal">
        <div class="text-center mb-10">
          <div class="section-divider"></div>
          <h2
            class="text-3xl lg:text-4xl font-normal text-balance mb-2"
            style="font-family: var(--font-heading); color: var(--charcoal);"
          >
            Prefer to send a message?
          </h2>
          <p class="text-sm" style="color: var(--warm-grey);">
            We'll get back to you as soon as possible.
          </p>
        </div>

        <div class="max-w-2xl mx-auto">
          <form
            action="/thanks"
            method="POST"
            data-static-form-name="booking-enquiry"
            class="space-y-5"
          >
            {/* Honeypot field — bots fill it, humans don't see it */}
            <input
              type="text"
              name="company_website"
              tabindex="-1"
              autocomplete="off"
              style="position: absolute; left: -9999px; width: 1px; height: 1px; opacity: 0;"
              aria-hidden="true"
            />
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
              <div>
                <label for="name" class="block text-sm font-medium mb-2" style="color: var(--charcoal);">
                  Your Name
                </label>
                <input
                  type="text"
                  id="name"
                  name="name"
                  required
                  placeholder="Jane Smith"
                  class="w-full px-4 py-3 rounded-xl text-sm outline-none transition-all duration-200"
                  style="border: 1px solid var(--light-grey); color: var(--charcoal); background: white;"
                  onfocus="this.style.borderColor='var(--rose-primary)'; this.style.boxShadow='0 0 0 3px rgba(92,58,30,0.12)'"
                  onblur="this.style.borderColor='var(--light-grey)'; this.style.boxShadow='none'"
                />
              </div>
              <div>
                <label for="email" class="block text-sm font-medium mb-2" style="color: var(--charcoal);">
                  Email Address
                </label>
                <input
                  type="email"
                  id="email"
                  name="email"
                  required
                  placeholder="jane@example.com"
                  class="w-full px-4 py-3 rounded-xl text-sm outline-none transition-all duration-200"
                  style="border: 1px solid var(--light-grey); color: var(--charcoal); background: white;"
                  onfocus="this.style.borderColor='var(--rose-primary)'; this.style.boxShadow='0 0 0 3px rgba(92,58,30,0.12)'"
                  onblur="this.style.borderColor='var(--light-grey)'; this.style.boxShadow='none'"
                />
              </div>
            </div>
            <div>
              <label for="message" class="block text-sm font-medium mb-2" style="color: var(--charcoal);">
                Message
              </label>
              <textarea
                id="message"
                name="message"
                required
                rows="4"
                placeholder="Tell us how we can help..."
                class="w-full px-4 py-3 rounded-xl text-sm outline-none transition-all duration-200 resize-none"
                style="border: 1px solid var(--light-grey); color: var(--charcoal); background: white;"
                onfocus="this.style.borderColor='var(--rose-primary)'; this.style.boxShadow='0 0 0 3px rgba(92,58,30,0.12)'"
                onblur="this.style.borderColor='var(--light-grey)'; this.style.boxShadow='none'"
              ></textarea>
            </div>
            <button
              type="submit"
              class="w-full py-4 rounded-full text-sm font-medium tracking-wide text-white transition-all duration-200"
              style="background-color: var(--rose-primary);"
              onmouseover="this.style.backgroundColor='var(--rose-deep)'"
              onmouseout="this.style.backgroundColor='var(--rose-primary)'"
            >
              Send Message
            </button>
          </form>
        </div>
      </div>
    </div>
  </section>

  <Footer />
</Layout>
