---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import PageHero from '../components/PageHero.astro';

import { categories } from '../data/treatments';
---

<Layout
  title="Pricing — Skin Aesthetics Northampton"
  description="Transparent pricing for all aesthetic treatments at Skin Aesthetics Northampton. PRP from £120, microneedling from £80, facials from £75. No hidden fees."
>
  <Nav />

  <PageHero
    title="Pricing"
    subtitle="Transparent pricing — no hidden fees. All prices are inclusive."
  />

  <!-- Promo highlight -->
  <div
    class="py-6 px-6 text-center"
    style="background-color: var(--blush-light); border-bottom: 1px solid var(--blush);"
  >
    <p class="text-base font-medium" style="color: var(--charcoal); font-family: var(--font-heading);">
      ✨ Enjoy <span style="color: var(--rose-primary);">15% OFF</span> any treatment + <span style="color: var(--rose-primary);">FREE</span> skin consultation — <a href="/book" style="color: var(--rose-primary);" class="underline underline-offset-2">Book today</a>
    </p>
  </div>

  <section class="py-20 px-6 lg:px-8" style="background: white;">
    <div class="max-w-4xl mx-auto space-y-12">
      {categories.map((cat, ci) => (
        <div class={`reveal reveal-delay-${(ci % 3) + 1}`}>
          <div class="flex items-center gap-3 mb-4">
            <div
              class="w-10 h-10 rounded-full flex items-center justify-center text-lg shrink-0"
              style="background-color: var(--blush-light); color: var(--rose-primary);"
            >
              {cat.icon}
            </div>
            <div>
              <h2
                class="text-2xl font-medium"
                style="font-family: var(--font-heading); color: var(--charcoal);"
              >
                {cat.name}
              </h2>
              <p class="text-sm" style="color: var(--warm-grey);">{cat.tagline}</p>
            </div>
          </div>
          <div class="rounded-xl overflow-hidden" style="border: 1px solid var(--light-grey);">
            {cat.treatments.map((t, ti) => (
              <div
                class="flex items-center justify-between px-5 py-3.5"
                style={`background: ${ti % 2 === 0 ? 'white' : 'var(--off-white)'}; border-bottom: ${ti < cat.treatments.length - 1 ? '1px solid var(--light-grey)' : 'none'};`}
              >
                <span class="text-sm" style="color: var(--charcoal);">{t.name}</span>
                <span
                  class="text-sm font-semibold ml-4 shrink-0"
                  style="color: var(--rose-primary);"
                >
                  {t.price}
                </span>
              </div>
            ))}
          </div>
          <div class="mt-3 text-right">
            <a
              href={`/services/${cat.slug}`}
              class="text-xs font-medium transition-colors duration-200"
              style="color: var(--warm-grey);"
              onmouseover="this.style.color='var(--rose-primary)'"
              onmouseout="this.style.color='var(--warm-grey)'"
            >
              Learn more about {cat.name} →
            </a>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- CTA -->
  <section
    class="py-20 px-6 lg:px-8 text-center"
    style="background: linear-gradient(135deg, var(--rose-primary) 0%, var(--coral) 100%);"
  >
    <div class="max-w-2xl mx-auto reveal">
      <h2
        class="text-3xl lg:text-4xl font-light text-white mb-4"
        style="font-family: var(--font-heading);"
      >
        Ready to book your treatment?
      </h2>
      <p class="text-white opacity-90 mb-8">
        Book online in minutes — or start with a free consultation.
      </p>
      <a
        href="/book"
        class="inline-flex items-center justify-center px-10 py-4 rounded-full text-sm font-medium tracking-wide bg-white transition-all duration-200"
        style="color: var(--rose-primary);"
        onmouseover="this.style.background='var(--off-white)'"
        onmouseout="this.style.background='white'"
      >
        Book Now
      </a>
    </div>
  </section>

  <Footer />
</Layout>
