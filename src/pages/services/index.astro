---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import PageHero from '../../components/PageHero.astro';

import { categories } from '../../data/treatments';
---

<Layout
  title="Our Treatments — Skin Aesthetics Northampton"
  description="Explore our full range of premium aesthetic treatments in Northampton: PRP, PRF, microneedling, skin boosters, facials, dermaplaning and chemical peels."
>
  <Nav />

  <PageHero
    title="Treatments"
    subtitle="Eight treatment categories. Each one tailored to you."
  />

  <section class="py-40 px-6 lg:px-8" style="background: white;">
    <div class="max-w-6xl mx-auto">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-0">
        {categories.map((cat, i) => (
          <a
            href={`/services/${cat.slug}`}
            class={`group block reveal reveal-delay-${(i % 4) + 1} pt-8 pb-8 ${i === 0 ? '' : 'border-t'}`}
            style={i === 0 ? '' : 'border-color: rgba(42,32,24,0.10);'}
          >
            <div class="flex items-baseline gap-6 mb-3">
              <span
                class="text-xs font-medium tracking-[0.2em]"
                style="color: var(--caramel);"
              >
                {String(i + 1).padStart(2, '0')}
              </span>
              <div class="flex-1"></div>
              <span
                class="text-xs font-medium tracking-wide"
                style="color: var(--brown-primary);"
              >
                From {cat.startingFrom}
              </span>
            </div>
            <h2
              class="text-2xl font-medium mb-3 transition-colors duration-200 group-hover:opacity-70"
              style="color: var(--charcoal);"
            >
              {cat.name}
            </h2>
            <p class="text-base leading-relaxed mb-4" style="color: var(--warm-grey);">
              {cat.tagline}
            </p>
            <span
              class="text-sm font-medium tracking-wide inline-flex items-center gap-2"
              style="color: var(--brown-primary);"
            >
              View treatment
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section
    class="py-40 px-6 lg:px-8 text-center"
    style="background-color: var(--ivory);"
  >
    <div class="max-w-2xl mx-auto reveal">
      <h2
        class="text-3xl lg:text-4xl font-normal text-balance mb-4"
        style="font-family: var(--font-heading); color: var(--charcoal);"
      >
        Not sure where to start?
      </h2>
      <p class="text-base mb-10" style="color: var(--warm-grey);">
        Book a free consultation. We'll build a plan tailored to your skin.
      </p>
      <a
        href="/book"
        class="inline-flex items-center justify-center px-8 py-4 rounded-sm text-sm font-medium tracking-wide text-white transition-all duration-200"
        style="background-color: var(--brown-primary);"
        onmouseover="this.style.backgroundColor='var(--brown-deep)'"
        onmouseout="this.style.backgroundColor='var(--brown-primary)'"
      >
        Book a Free Consultation
      </a>
    </div>
  </section>

  <Footer />
</Layout>
