---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import Icon from '../../components/Icon.astro';

import { categories, getCategoryBySlug } from '../../data/treatments';

export function getStaticPaths() {
  return categories.map((cat) => ({ params: { slug: cat.slug } }));
}

const { slug } = Astro.params;
const category = getCategoryBySlug(slug);

if (!category) {
  return Astro.redirect('/services');
}
---

<Layout
  title={`${category.name} — Skin Aesthetics Northampton`}
  description={`${category.description} Starting from ${category.startingFrom}. Book at Skin Aesthetics Northampton.`}
>
  <Nav />


  <!-- Hero -->
  <section
    class="relative pt-52 pb-24 overflow-hidden"
    style="background: linear-gradient(135deg, var(--blush-light) 0%, var(--off-white) 70%, white 100%);"
  >
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
      <div class="absolute top-10 right-10 w-64 h-64 rounded-full opacity-15"
        style="background: radial-gradient(circle, var(--blush) 0%, transparent 70%);"></div>
    </div>
    <div class="max-w-4xl mx-auto px-6 lg:px-8">
      <a
        href="/services"
        class="inline-flex items-center gap-2 text-sm mb-8 transition-colors duration-200"
        style="color: var(--warm-grey);"
        onmouseover="this.style.color='var(--rose-primary)'"
        onmouseout="this.style.color='var(--warm-grey)'"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16l-4-4m0 0l4-4m-4 4h18" />
        </svg>
        All Treatments
      </a>
      <div class="section-divider" style="margin-left: 0;"></div>
      <div
        class="inline-flex items-center justify-center w-16 h-16 rounded-full mb-6"
        style="background-color: var(--blush-light); color: var(--rose-primary);"
      >
        <Icon name={category.icon} class="w-8 h-8" />
      </div>
      <h1
        class="text-5xl lg:text-6xl font-light leading-tight mb-4"
        style="font-family: var(--font-heading); color: var(--charcoal);"
      >
        {category.name}
      </h1>
      <p class="text-xl mb-8" style="color: var(--warm-grey); font-family: var(--font-heading); font-style: italic;">
        {category.tagline}
      </p>
      <a
        href="/book"
        class="inline-flex items-center justify-center px-8 py-4 rounded-full text-sm font-medium tracking-wide text-white transition-all duration-200"
        style="background-color: var(--rose-primary);"
        onmouseover="this.style.backgroundColor='#b36370'"
        onmouseout="this.style.backgroundColor='var(--rose-primary)'"
      >
        Book This Treatment
      </a>
    </div>
  </section>

  <!-- Overview -->
  <section class="py-20 px-6 lg:px-8" style="background: white;">
    <div class="max-w-4xl mx-auto">
      <div class="grid grid-cols-1 lg:grid-cols-5 gap-12">
        <div class="lg:col-span-3 reveal">
          <h2
            class="text-3xl font-light mb-5"
            style="font-family: var(--font-heading); color: var(--charcoal);"
          >
            Treatment Overview
          </h2>
          <p class="text-base leading-relaxed text-justify" style="color: var(--warm-grey);">
            {category.longDescription}
          </p>
        </div>
        <div class="lg:col-span-2 reveal reveal-delay-2">
          <div
            class="rounded-2xl p-6"
            style="background-color: var(--blush-light); border: 1px solid var(--blush);"
          >
            <h3
              class="text-lg font-medium mb-4"
              style="font-family: var(--font-heading); color: var(--charcoal);"
            >
              What to Expect
            </h3>
            <ul class="space-y-3">
              {category.whatToExpect.map((step) => (
                <li class="flex items-start gap-3 text-sm" style="color: var(--warm-grey);">
                  <svg class="mt-1 shrink-0 w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor" style="color: var(--rose-primary);" aria-hidden="true">
                    <path d="M12 2 L13.5 9 L20.5 10.5 L13.5 12 L12 19 L10.5 12 L3.5 10.5 L10.5 9 Z" />
                  </svg>
                  {step}
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Pricing -->
  <section class="py-20 px-6 lg:px-8" style="background-color: var(--off-white);">
    <div class="max-w-3xl mx-auto">
      <div class="text-center mb-12 reveal">
        <h2
          class="text-3xl lg:text-4xl font-light mb-2"
          style="font-family: var(--font-heading); color: var(--charcoal);"
        >
          Treatment Options & Pricing
        </h2>
        <p class="text-sm" style="color: var(--warm-grey);">Transparent pricing. No hidden fees.</p>
      </div>
      <div class="rounded-2xl overflow-hidden reveal" style="border: 1px solid var(--light-grey);">
        {category.treatments.map((t, i) => (
          <div
            class="flex items-center justify-between px-6 py-4"
            style={`background: ${i % 2 === 0 ? 'white' : 'var(--off-white)'}; border-bottom: ${i < category.treatments.length - 1 ? '1px solid var(--light-grey)' : 'none'};`}
          >
            <span class="text-sm font-medium" style="color: var(--charcoal);">{t.name}</span>
            <span
              class="text-sm font-medium ml-4 shrink-0"
              style="color: var(--rose-primary);"
            >
              {t.price}
            </span>
          </div>
        ))}
      </div>
      <div class="mt-8 text-center reveal">
        <a
          href="/book"
          class="inline-flex items-center justify-center px-8 py-4 rounded-full text-sm font-medium tracking-wide text-white transition-all duration-200"
          style="background-color: var(--rose-primary);"
          onmouseover="this.style.backgroundColor='#b36370'"
          onmouseout="this.style.backgroundColor='var(--rose-primary)'"
        >
          Book Now
        </a>
      </div>
    </div>
  </section>

  <!-- FAQs -->
  <section class="py-20 px-6 lg:px-8" style="background: white;">
    <div class="max-w-3xl mx-auto">
      <div class="text-center mb-12 reveal">
        <h2
          class="text-3xl lg:text-4xl font-light"
          style="font-family: var(--font-heading); color: var(--charcoal);"
        >
          Frequently Asked Questions
        </h2>
      </div>
      <div class="space-y-4">
        {category.faqs.map((faq, i) => (
          <details
            class={`group rounded-xl overflow-hidden reveal reveal-delay-${(i % 3) + 1}`}
            style="border: 1px solid var(--light-grey);"
          >
            <summary
              class="flex items-center justify-between px-6 py-4 cursor-pointer text-sm font-medium list-none"
              style="color: var(--charcoal);"
            >
              {faq.question}
              <svg
                class="w-5 h-5 shrink-0 ml-4 transition-transform duration-200 group-open:rotate-180"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                style="color: var(--rose-primary);"
              >
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </summary>
            <div class="px-6 pb-5 text-sm leading-relaxed" style="color: var(--warm-grey);">
              {faq.answer}
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Bottom CTA -->
  <section
    class="py-20 px-6 lg:px-8 text-center"
    style="background: linear-gradient(135deg, var(--rose-primary) 0%, var(--coral) 100%);"
  >
    <div class="max-w-2xl mx-auto reveal">
      <h2
        class="text-3xl lg:text-4xl font-light text-white mb-4"
        style="font-family: var(--font-heading);"
      >
        Ready to book {category.name}?
      </h2>
      <p class="text-white opacity-90 mb-8" style="font-family: var(--font-body);">
        Book your appointment online or start with a free consultation.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href="/book"
          class="inline-flex items-center justify-center px-8 py-4 rounded-full text-sm font-medium tracking-wide bg-white transition-all duration-200"
          style="color: var(--rose-primary);"
          onmouseover="this.style.background='var(--off-white)'"
          onmouseout="this.style.background='white'"
        >
          Book Now
        </a>
        <a
          href="/contact"
          class="inline-flex items-center justify-center px-8 py-4 rounded-full text-sm font-medium tracking-wide transition-all duration-200"
          style="border: 1.5px solid rgba(255,255,255,0.7); color: white;"
          onmouseover="this.style.background='rgba(255,255,255,0.15)'"
          onmouseout="this.style.background='transparent'"
        >
          Get In Touch
        </a>
      </div>
    </div>
  </section>

  <Footer />
</Layout>
