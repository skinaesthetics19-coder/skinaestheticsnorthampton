---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import Icon from '../../components/Icon.astro';

import { categories, getCategoryBySlug } from '../../data/treatments';

export function getStaticPaths() {
  return categories.map((cat) => ({ params: { slug: cat.slug } }));
}

const { slug } = Astro.params;
const category = getCategoryBySlug(slug);

if (!category) {
  return Astro.redirect('/services');
}
---

<Layout
  title={`${category.name} — Skin Aesthetics Northampton`}
  description={`${category.description} Starting from ${category.startingFrom}. Book at Skin Aesthetics Northampton.`}
>
  <Nav />


  <!-- Hero -->
  <section
    class="relative pt-52 pb-32 overflow-hidden"
    style="background: var(--ivory);"
  >
    <div class="max-w-4xl mx-auto px-6 lg:px-8">
      <a
        href="/services"
        class="inline-flex items-center gap-2 text-sm mb-12 transition-colors duration-200"
        style="color: var(--warm-grey);"
        onmouseover="this.style.color='var(--brown-primary)'"
        onmouseout="this.style.color='var(--warm-grey)'"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 16l-4-4m0 0l4-4m-4 4h18" />
        </svg>
        All Treatments
      </a>
      <p
        class="text-xs font-medium tracking-[0.2em] uppercase mb-6"
        style="color: var(--caramel);"
      >
        Treatment
      </p>
      <h1
        class="text-5xl lg:text-7xl font-light leading-[1.05] mb-6"
        style="font-family: var(--font-heading); color: var(--charcoal);"
      >
        {category.name}
      </h1>
      <p class="text-xl lg:text-2xl mb-10 max-w-2xl" style="color: var(--warm-grey); font-family: var(--font-heading); font-style: italic; font-weight: 300;">
        {category.tagline}
      </p>
      <a
        href="/book"
        class="inline-flex items-center justify-center px-8 py-4 rounded-sm text-sm font-medium tracking-wide text-white transition-all duration-200"
        style="background-color: var(--brown-primary);"
        onmouseover="this.style.backgroundColor='var(--brown-deep)'"
        onmouseout="this.style.backgroundColor='var(--brown-primary)'"
      >
        Book This Treatment
      </a>
    </div>
  </section>

  <!-- Overview -->
  <section class="py-28 px-6 lg:px-8" style="background: white;">
    <div class="max-w-4xl mx-auto">
      <div class="grid grid-cols-1 lg:grid-cols-5 gap-12">
        <div class="lg:col-span-3 reveal">
          <h2
            class="text-3xl font-light mb-5"
            style="font-family: var(--font-heading); color: var(--charcoal);"
          >
            Treatment Overview
          </h2>
          {category.longDescription.split('\n\n').map((para) => (
            <p class="text-base leading-relaxed mb-4 last:mb-0" style="color: var(--warm-grey);">
              {para}
            </p>
          ))}
        </div>
        <div class="lg:col-span-2 reveal reveal-delay-2">
          <div
            class="rounded-2xl p-7"
            style="background-color: var(--ivory); border: 1px solid var(--light-grey);"
          >
            <p class="text-xs font-medium tracking-[0.2em] uppercase mb-4" style="color: var(--caramel);">
              What to expect
            </p>
            <h3
              class="text-2xl font-light mb-5"
              style="font-family: var(--font-heading); color: var(--charcoal);"
            >
              Your visit, step by step.
            </h3>
            <ul class="space-y-3">
              {category.whatToExpect.map((step) => (
                <li class="flex items-start gap-3 text-sm" style="color: var(--warm-grey);">
                  <span class="mt-1.5 shrink-0 w-1.5 h-1.5 rounded-full" style="background: var(--caramel);"></span>
                  {step}
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Pricing -->
  <section class="py-28 px-6 lg:px-8" style="background-color: var(--off-white);">
    <div class="max-w-3xl mx-auto">
      <div class="text-center mb-12 reveal">
        <h2
          class="text-3xl lg:text-4xl font-light mb-2"
          style="font-family: var(--font-heading); color: var(--charcoal);"
        >
          Treatment Options & Pricing
        </h2>
        <p class="text-sm" style="color: var(--warm-grey);">Transparent pricing. No hidden fees.</p>
      </div>
      <div class="rounded-2xl overflow-hidden reveal" style="border: 1px solid var(--light-grey);">
        {category.treatments.map((t, i) => (
          <div
            class="flex items-center justify-between px-6 py-4"
            style={`background: ${i % 2 === 0 ? 'white' : 'var(--off-white)'}; border-bottom: ${i < category.treatments.length - 1 ? '1px solid var(--light-grey)' : 'none'};`}
          >
            <span class="text-sm font-medium" style="color: var(--charcoal);">{t.name}</span>
            <span
              class="text-sm font-medium ml-4 shrink-0"
              style="color: var(--charcoal);"
            >
              {t.price}
            </span>
          </div>
        ))}
      </div>
      <div class="mt-8 text-center reveal">
        <a
          href="/book"
          class="inline-flex items-center justify-center px-8 py-4 rounded-sm text-sm font-medium tracking-wide text-white transition-all duration-200"
          style="background-color: var(--rose-primary);"
          onmouseover="this.style.backgroundColor='var(--rose-deep)'"
          onmouseout="this.style.backgroundColor='var(--rose-primary)'"
        >
          Book Now
        </a>
      </div>
    </div>
  </section>

  <!-- FAQs -->
  <section class="py-28 px-6 lg:px-8" style="background: white;">
    <div class="max-w-3xl mx-auto">
      <div class="text-center mb-12 reveal">
        <h2
          class="text-3xl lg:text-4xl font-light"
          style="font-family: var(--font-heading); color: var(--charcoal);"
        >
          Frequently Asked Questions
        </h2>
      </div>
      <div class="space-y-4">
        {category.faqs.map((faq, i) => (
          <details
            class={`group rounded-xl overflow-hidden reveal reveal-delay-${(i % 3) + 1}`}
            style="border: 1px solid var(--light-grey);"
          >
            <summary
              class="flex items-center justify-between px-6 py-4 cursor-pointer text-sm font-medium list-none"
              style="color: var(--charcoal);"
            >
              {faq.question}
              <svg
                class="w-5 h-5 shrink-0 ml-4 transition-transform duration-200 group-open:rotate-180"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                style="color: var(--rose-primary);"
              >
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </summary>
            <div class="px-6 pb-5 text-sm leading-relaxed" style="color: var(--warm-grey);">
              {faq.answer}
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Bottom CTA -->
  <section
    class="py-28 px-6 lg:px-8 text-center"
    style="background: var(--off-white);"
  >
    <div class="max-w-2xl mx-auto reveal">
      <div class="section-divider"></div>
      <h2
        class="text-3xl lg:text-4xl font-light mb-4"
        style="font-family: var(--font-heading); color: var(--charcoal);"
      >
        Ready to book {category.name}?
      </h2>
      <p class="mb-8" style="font-family: var(--font-body); color: var(--body-text);">
        Book your appointment online or start with a free consultation.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href="/book"
          class="inline-flex items-center justify-center px-8 py-4 rounded-sm text-sm font-medium tracking-wide text-white transition-all duration-200"
          style="background-color: var(--rose-primary);"
          onmouseover="this.style.backgroundColor='var(--rose-deep)'"
          onmouseout="this.style.backgroundColor='var(--rose-primary)'"
        >
          Book Now
        </a>
        <a
          href="/contact"
          class="inline-flex items-center justify-center px-8 py-4 rounded-sm text-sm font-medium tracking-wide transition-all duration-200"
          style="border: 1.5px solid var(--rose-primary); color: var(--rose-primary);"
          onmouseover="this.style.background='var(--rose-primary)'; this.style.color='white';"
          onmouseout="this.style.background='transparent'; this.style.color='var(--rose-primary)';"
        >
          Get In Touch
        </a>
      </div>
    </div>
  </section>

  <Footer />
</Layout>
